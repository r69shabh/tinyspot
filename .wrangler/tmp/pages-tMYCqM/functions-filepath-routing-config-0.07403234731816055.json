{
  "routes": [
    {
      "routePath": "/api/checkout",
      "mountPath": "/api",
      "method": "OPTIONS",
      "module": [
        "api/checkout.js:onRequestOptions"
      ]
    },
    {
      "routePath": "/api/checkout",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/checkout.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/claim",
      "mountPath": "/api",
      "method": "OPTIONS",
      "module": [
        "api/claim.js:onRequestOptions"
      ]
    },
    {
      "routePath": "/api/claim",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/claim.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/reset",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/reset.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/spots",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/spots.js:onRequestGet"
      ]
    }
  ],
  "baseURL": "/"
}